# -------------------------------------------------------------------------- #
# Quartus II / Prime Project Assignments File
# Top-Level Entity: rv32im_soc
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY rv32im_soc
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1STD.0 LITE EDITION"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PACKAGE "ANY QFP"
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144

# Performance & Multi-Core Synthesis
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name FLOW_ENABLE_RTL_VIEWER ON
set_global_assignment -name FLOW_ENABLE_IO_ASSIGNMENT_ANALYSIS ON
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON

# -------------------------------------------------------------------------- #
# Source Files
# -------------------------------------------------------------------------- #
# Core Pipeline Files
set_global_assignment -name VHDL_FILE rtl/core/Program_Counter.vhd
set_global_assignment -name VHDL_FILE rtl/core/Instruction_Memory.vhd
set_global_assignment -name VHDL_FILE rtl/core/IF_ID_Register.vhd
set_global_assignment -name VHDL_FILE rtl/core/RegFile.vhd
set_global_assignment -name VHDL_FILE rtl/core/ImmGen.vhd
set_global_assignment -name VHDL_FILE rtl/core/ID_EX_Register.vhd
set_global_assignment -name VHDL_FILE rtl/core/Control_Unit.vhd
set_global_assignment -name VHDL_FILE rtl/core/ALU.vhd
set_global_assignment -name VHDL_FILE rtl/core/M_Extension_Unit.vhd
set_global_assignment -name VHDL_FILE rtl/core/Hazard_Unit.vhd
set_global_assignment -name VHDL_FILE rtl/core/Forwarding_Unit.vhd
set_global_assignment -name VHDL_FILE rtl/core/EX_MEM_Register.vhd
set_global_assignment -name VHDL_FILE rtl/core/Data_Memory.vhd
set_global_assignment -name VHDL_FILE rtl/core/MEM_WB_Register.vhd
set_global_assignment -name VHDL_FILE rtl/core/IF_Stage.vhd
set_global_assignment -name VHDL_FILE rtl/core/ID_Stage.vhd
set_global_assignment -name VHDL_FILE rtl/core/EX_Stage.vhd
set_global_assignment -name VHDL_FILE rtl/core/MEM_Stage.vhd
set_global_assignment -name VHDL_FILE rtl/core/CPU_FPGA.vhd
set_global_assignment -name VHDL_FILE rtl/core/CPU_Top_Wrapper.vhd

# Memory & SoC Interconnect Files
set_global_assignment -name VHDL_FILE rtl/memory/bram_4kb.vhd
set_global_assignment -name VHDL_FILE rtl/memory/bus_interconnect.vhd
set_global_assignment -name VHDL_FILE rtl/rv32im_soc.vhd

# Peripheral Core Files
set_global_assignment -name VHDL_FILE rtl/peripherals/uart_tx.vhd
set_global_assignment -name VHDL_FILE rtl/peripherals/Bus_Decoder.vhd
set_global_assignment -name VHDL_FILE rtl/peripherals/gpio_led.vhd
set_global_assignment -name VHDL_FILE rtl/peripherals/gpio_key.vhd
set_global_assignment -name VHDL_FILE rtl/peripherals/timer.vhd

# Simulation Testbenches
set_global_assignment -name VHDL_FILE sim/tb_CPU_FPGA.vhd
set_global_assignment -name VHDL_FILE sim/ImmGen_tb.vhd
set_global_assignment -name VHDL_FILE sim/ALU_tb.vhd
set_global_assignment -name VHDL_FILE sim/M_Extension_Unit_tb.vhd

# -------------------------------------------------------------------------- #
# FPGA Physical Pin Assignments (Cyclone IV EP4CE6E22C8)
# -------------------------------------------------------------------------- #
# Clock & System Reset
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_25 -to rst_n

# Push Buttons / Keys (Active-Low Inputs)
set_location_assignment PIN_88 -to gpio_keys[0]
set_location_assignment PIN_89 -to gpio_keys[1]
set_location_assignment PIN_90 -to gpio_keys[2]
set_location_assignment PIN_91 -to gpio_keys[3]

# Onboard Diagnostic LEDs (Active-Low Outputs)
set_location_assignment PIN_87 -to gpio_leds[0]
set_location_assignment PIN_86 -to gpio_leds[1]
set_location_assignment PIN_85 -to gpio_leds[2]
set_location_assignment PIN_84 -to gpio_leds[3]

# UART Lines
set_location_assignment PIN_114 -to uart_tx
set_location_assignment PIN_115 -to uart_rx

# I/O Standards & Configuration
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CRC_ERROR_OPEN_DRAIN OFF
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -rise
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -fall
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -rise
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -fall
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# Partition Assignments
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name EDA_DESIGN_ENTRY_SYNTHESIS_TOOL "<None>"

set_global_assignment -name SDC_FILE CPU_FPGA.sdc
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name EDA_INPUT_DATA_FORMAT EDIF -section_id eda_design_synthesis
set_global_assignment -name VHDL_FILE sim/tb_rv32im_soc.vhd
set_global_assignment -name VHDL_FILE rtl/memory/sdram_controller.vhd
set_global_assignment -name VHDL_FILE rtl/memory/periph_bridge.vhd
set_global_assignment -name VHDL_FILE rtl/peripherals/periph_bridge.vhd
set_global_assignment -name VHDL_FILE sim/sdram_model.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top