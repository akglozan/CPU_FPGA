# -------------------------------------------------------------------------- #
# Quartus II / Prime Project Assignments File
# Top-Level Entity: rv32im_soc
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY rv32im_soc
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1STD.0 LITE EDITION"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PACKAGE "ANY QFP"
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144

# Performance & Multi-Core Synthesis
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name FLOW_ENABLE_RTL_VIEWER ON
set_global_assignment -name FLOW_ENABLE_IO_ASSIGNMENT_ANALYSIS ON
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON

# -------------------------------------------------------------------------- #
# Source Files
# -------------------------------------------------------------------------- #
# Core Pipeline Files

# Memory & SoC Interconnect Files

# Peripheral Core Files

# Simulation Testbenches

# -------------------------------------------------------------------------- #
# FPGA Physical Pin Assignments (Cyclone IV EP4CE6E22C8)
# -------------------------------------------------------------------------- #
# Clock & System Reset
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_25 -to rst_n

# Push Buttons / Keys (Active-Low Inputs)
set_location_assignment PIN_88 -to gpio_keys[0]
set_location_assignment PIN_89 -to gpio_keys[1]
set_location_assignment PIN_90 -to gpio_keys[2]
set_location_assignment PIN_91 -to gpio_keys[3]

# Onboard Diagnostic LEDs (Active-Low Outputs)
set_location_assignment PIN_87 -to gpio_leds[0]
set_location_assignment PIN_86 -to gpio_leds[1]
set_location_assignment PIN_85 -to gpio_leds[2]
set_location_assignment PIN_84 -to gpio_leds[3]

# UART Lines
set_location_assignment PIN_114 -to uart_tx
set_location_assignment PIN_115 -to uart_rx

# ==============================================================================
# SDRAM Physical Pin Assignments (Cyclone IV EP4CE6E22C8)
# ==============================================================================
# SDRAM Control Signals
set_location_assignment PIN_58 -to sdram_cke
set_location_assignment PIN_72 -to sdram_cs_n
set_location_assignment PIN_71 -to sdram_ras_n
set_location_assignment PIN_70 -to sdram_cas_n
set_location_assignment PIN_69 -to sdram_we_n
set_location_assignment PIN_73 -to sdram_ba[0]
set_location_assignment PIN_74 -to sdram_ba[1]
set_location_assignment PIN_42 -to sdram_dqm[0]
set_location_assignment PIN_55 -to sdram_dqm[1]

# SDRAM Address Bus
set_location_assignment PIN_76 -to sdram_addr[0]
set_location_assignment PIN_77 -to sdram_addr[1]
set_location_assignment PIN_80 -to sdram_addr[2]
set_location_assignment PIN_83 -to sdram_addr[3]
set_location_assignment PIN_68 -to sdram_addr[4]
set_location_assignment PIN_67 -to sdram_addr[5]
