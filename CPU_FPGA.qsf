# -------------------------------------------------------------------------- #
# FPGA Physical Pin Assignments (Cyclone IV EP4CE6E22C8)
# -------------------------------------------------------------------------- #
# Clock & System Reset
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_25 -to rst_n

# Push Buttons / Keys (Active-Low Inputs)
set_location_assignment PIN_88 -to gpio_keys[0]
set_location_assignment PIN_89 -to gpio_keys[1]
set_location_assignment PIN_90 -to gpio_keys[2]
set_location_assignment PIN_91 -to gpio_keys[3]

# Onboard Diagnostic LEDs (Active-Low Outputs)
set_location_assignment PIN_87 -to gpio_leds[0]
set_location_assignment PIN_86 -to gpio_leds[1]
set_location_assignment PIN_85 -to gpio_leds[2]
set_location_assignment PIN_84 -to gpio_leds[3]

# UART Lines
set_location_assignment PIN_114 -to uart_tx
set_location_assignment PIN_115 -to uart_rx

# ESP32 Boot-Loader SPI Slave Link (see rtl/memory/spi_slave.vhd,
# rtl/memory/boot_loader.vhd). Reassigned from the onboard digital
# tube's SEG0/SEG1/SEG2 pins -- that display isn't used by this
# project, and those segments are just passive LEDs behind current-
# limiting resistors (no active driver IC sharing the line), unlike
# the onboard I2C EEPROM/temp-sensor pins or the AS_DATA config-flash
# pins, which were ruled out as unsafe to repurpose. Verified against
# the EP4CE6 datasheet: plain user I/O, no dedicated function.
set_location_assignment PIN_128 -to spi_sclk
set_location_assignment PIN_121 -to spi_mosi
set_location_assignment PIN_125 -to spi_cs_n

# spi_cs_n idles high (deasserted) but is an INPUT here, and the ESP32
# does not drive it until a few hundred ms into its own boot -- by which
# time the FPGA is long out of reset and already sampling the pin. A
# floating input in that window is what produced one spurious CS falling
# edge per boot (the FPGA counted 3 assertions for a 2-file transfer).
# Harmless in itself -- spi_slave only resets an already-empty bit
# counter while CS is high, and the edge lands before any data -- but a
# floating input beside actively switching SPI lines is worth
# terminating. The firmware now also drives this pin at the very top of
# setup(), which narrows the window but cannot cover the ESP32's own
# power-up.
#
# Honest caveat: this pin also drives a digital-tube segment LED (see
# the note above), so the internal weak pull-up (~25 kOhm) is working
# against an LED that clamps at its forward voltage, and may not reach a
# valid logic high on its own. It costs nothing and cannot hurt -- once
# the ESP32 drives the pin the pull-up sinks ~130 uA and is irrelevant
# -- but if this edge ever needs to be genuinely eliminated rather than
# just made less likely, the real fix is an external pull-up sized
# against that LED load, not this line.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to spi_cs_n

# Same reasoning as above (SEG3, passive LED load, verified plain I/O).
# ESP32 asserts this once done streaming the firmware/WAD over SPI,
# releasing the FPGA CPU from reset. See rv32im_soc.vhd's boot_done
# synchronizer/latch and cpu_rst_n.
set_location_assignment PIN_129 -to boot_done

