# 2026-08-27: phase-shifted SDRAM forwarded clock, see sdram_pll.vhd's
# header for why. Added as a plain VHDL_FILE (like bram_4kb.vhd and
# vga_line_buffer.vhd's direct altsyncram instantiations) rather than
# a QIP_FILE -- it instantiates the altera_mf altpll component
# directly, so no MegaWizard-tracked .qip wrapper is needed.
set_global_assignment -name VHDL_FILE sdram_pll.vhd

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top