library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity Program_Counter is
	generic(
	
	data_width:integer :=32
	
	);
	
	port(
		clk		: in	std_logic;
		reset		: in	std_logic;
		pc_write : in	std_logic;
		pc_load	: in 	std_logic;
		pc_in    : in  std_logic_vector(DATA_WIDTH-1 downto 0); 
      pc_out   : out std_logic_vector(DATA_WIDTH-1 downto 0)  
	
	);
end entity Program_Counter;


architecture Behavioral of Program_Counter is
	signal pc_reg : unsigned (DATA_WIDTH-1 downto 0) := (others => '0');
begin
	if reset = '1' then
		pc_reg <= (others => '0');
	elseif rising_edge(clk) then
		if pc_write = '1' then
			if pc_load = '1' then
				pc_reg <=unsigned(pc_in);
			else
				pc_reg <= pc_reg + 4; ---'4' indicates a 4 byte(32 bit) since instructions are made of 32 bits
			end if;
		end if;
	end if;
end process;

pc_out <= std_logic_vector(pc_reg);

end architecture Behavioral;